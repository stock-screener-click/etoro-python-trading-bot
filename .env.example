# Copy to .env and fill in. Load with `set -a; source .env; set +a` or use direnv.

# RapidAPI - from https://rapidapi.com after subscribing to Stock Screener
RAPIDAPI_KEY=
RAPIDAPI_HOST=

# eToro Public API - from Settings -> Trading -> API Key Management
ETORO_API_KEY=
ETORO_USER_KEY=

# "demo" (default) or "real" - controls which eToro environment the bot trades in
ETORO_MODE=demo

# Optional kill switch - set to any non-empty value to skip rebalancing
# BOT_DISABLED=1
